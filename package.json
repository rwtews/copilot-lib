{
  "name": "copilot-agents",
  "version": "1.0.0",
  "description": "Repositorio personal de agentes e instrucciones para GitHub Copilot",
  "main": "src/index.js",
  "bin": {
    "copilot-agents": "./bin/copilot-agents.js"
  },
  "scripts": {
    "start": "node bin/copilot-agents.js",
    "test": "node --test",
    "copilot:list": "npx copilot-agents list",
    "copilot:list:global": "npx copilot-agents list --global",
    "copilot:install": "npx copilot-agents install",
    "copilot:install:global": "npx copilot-agents install --global",
    "copilot:update": "npx copilot-agents update",
    "copilot:update:global": "npx copilot-agents update --global"
  },
  "keywords": [
    "github-copilot",
    "copilot",
    "agents",
    "instructions",
    "cli"
  ],
  "author": "rwtews",
  "license": "MIT",
  "dependencies": {
    "@inquirer/checkbox": "^5.2.1",
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
